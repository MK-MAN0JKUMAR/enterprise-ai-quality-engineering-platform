# --------------------------------------------------
# Default Provider Selection
# --------------------------------------------------

EATP_PROVIDER_DEFAULT_CHAT_PROVIDER=groq
EATP_PROVIDER_DEFAULT_EMBEDDING_PROVIDER=ollama
EATP_PROVIDER_DEFAULT_RERANKING_PROVIDER=ollama

# --------------------------------------------------
# Groq
# --------------------------------------------------

EATP_GROQ_ENABLED=true
EATP_GROQ_API_KEY=
EATP_GROQ_BASE_URL=https://api.groq.com/openai/v1
EATP_GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# --------------------------------------------------
# Ollama
# --------------------------------------------------

EATP_OLLAMA_ENABLED=true
EATP_OLLAMA_BASE_URL=http://localhost:11434
EATP_OLLAMA_CHAT_MODEL=llama3.1:8b
EATP_OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EATP_OLLAMA_RERANKING_MODEL=bge-reranker-v2-m3
